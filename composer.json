{
  "name": "wearesho-team/yii2-simple-cache-adapter",
  "description": "PSR-16 SimpleCache adapter for Yii2 cache",
  "license": "MIT",
  "type": "yii2-extension",
  "authors": [
    {
      "name": "Devon Liu",
      "email": "devonliu02@gmail.com"
    },
    {
      "name": "Alexander Letnikow",
      "email": "reclamme@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Wearesho\\SimpleCache\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wearesho\\SimpleCache\\Tests\\": "tests"
    },
    "files": [
      "vendor/yiisoft/yii2/Yii.php"
    ]
  },
  "require": {
    "php": ">=8.4",
    "psr/simple-cache": "^3.0",
    "yiisoft/yii2": "^2.0.52"
  },
  "require-dev": {
    "cache/integration-tests": "^1.0.5",
    "horat1us/yii2-asset-free": "^1.1",
    "phpunit/phpunit": "^13.4",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "config": {
    "process-timeout": 1800,
    "sort-packages": true,
    "platform": {
      "php": "8.4.1"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    }
  },
  "scripts": {
    "lint": "./vendor/bin/phpcs --standard=PSR2 ./src ./tests",
    "phpcbf": "./vendor/bin/phpcbf --standard=PSR2 ./src ./tests",
    "test": "./vendor/bin/phpunit",
    "cover": "XDEBUG_MODE=coverage ./vendor/bin/phpunit --coverage-clover ./coverage.xml"
  }
}
